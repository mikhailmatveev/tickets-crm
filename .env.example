APP_NAME="Tickets-CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_BACKEND_PORT=8080
APP_BACKEND_PORT_SECURE=443
APP_FRONTEND_PORT=5173
APP_PORT="${APP_BACKEND_PORT}"
APP_URL="http://localhost:${APP_PORT}"

APP_PATH=/var/www

HOST_UID=1000
HOST_GID=1000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Доступы для админа
ADMIN_NAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="password"

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_ROOT_PASSWORD=secret

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=tickets_crm
DB_USERNAME=root
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS="localhost:${APP_PORT},127.0.0.1:${APP_PORT},localhost:${APP_FRONTEND_PORT},127.0.0.1:${APP_FRONTEND_PORT}"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Локальный почтовый сервер Mailpit
# Запуск: docker run -d --name mailpit -p 8025:8025 -p 1025:1025 axllent/mailpit
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@tickets-crm.local
MAIL_FROM_NAME="${APP_NAME}"

# Порты для контейнера Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PORT="${APP_FRONTEND_PORT}"

TELESCOPE_ENABLED=true

# SSL / Let's Encrypt
DOMAIN=example.com
EMAIL=admin@example.com

# Версии образов
MARIADB_VERSION=11
NGINX_VERSION=alpine
NODE_VERSION=24
PHP_VERSION=8.4
REDIS_VERSION=7
